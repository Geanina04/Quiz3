#--------------------------------------------------------------------
# Entorno
#--------------------------------------------------------------------
# 'development' muestra los errores en pantalla; en un servidor real usar 'production'
CI_ENVIRONMENT = development

#--------------------------------------------------------------------
# URL base
#--------------------------------------------------------------------
# Si se deja comentada, se calcula automáticamente (ver app/Config/App.php).
# app.baseURL = 'http://localhost/quiz3/'

#--------------------------------------------------------------------
# Base de datos (valores por defecto de XAMPP)
#--------------------------------------------------------------------
database.default.hostname = 127.0.0.1
database.default.database = quiz3
database.default.username = root
database.default.password =
database.default.DBDriver = MySQLi
database.default.port = 3306
